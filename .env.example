# Copy to .env.local for local development. Never commit real values.

# Required. Server-side only. Get one at https://aistudio.google.com/apikey
GEMINI_API_KEY=your-api-key-here

# Primary model for analysis and chat. gemini-2.5-flash is deprecated (rerouted on 2026-12-01),
# so the default is the current low-cost Flash-Lite model. Check https://ai.google.dev/gemini-api/docs/models
GEMINI_MODEL=gemini-3.5-flash-lite

# Used when the primary model keeps returning 429/503/404.
GEMINI_FALLBACK_MODEL=gemini-3.1-flash-lite

# Largest accepted upload, in megabytes.
MAX_UPLOAD_MB=5

# Requests allowed per IP per minute (per route).
RATE_LIMIT_PER_MIN=10
